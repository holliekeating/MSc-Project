@article{BOUTROS2009,
title = {Sensory-gating deficit of the N100 mid-latency auditory evoked potential in medicated schizophrenia patients},
journal = {Schizophrenia Research},
volume = {113},
number = {2},
pages = {339-346},
year = {2009},
issn = {0920-9964},
doi = {https://doi.org/10.1016/j.schres.2009.05.019},
url = {https://www.sciencedirect.com/science/article/pii/S0920996409002308},
author = {Nash N. Boutros and Anke Brockhaus-Dumke and Klevest Gjini and Andrei Vedeniapin and Mohamad Elfakhani and Scott Burroughs and Matcheri Keshavan},
keywords = {Sensory-gating, Mid-latency evoked responses, P50, N100, Schizophrenia, PANSS, Wisconsin Card Sorting Test},
abstract = {The clinical and neuro-cognitive correlates of the P50 and N100 auditory evoked responses gating deficits in schizophrenia have thus far eluded identification. Based on our prior results, we hypothesized that, in addition to the P50, gating of the N100 is significantly decreased in schizophrenia and that this deficit correlates with the negative symptoms dimension of schizophrenia. Amplitudes and gating measures of the P50 and N100 were compared between stable out-patients (N=45) (mainly on atypical antipsychotics) with chronic schizophrenia and age- and gender-matched healthy controls (N=49) and the clinical correlates examined. All subjects underwent the paired-stimulus paradigm in 3 or 4 different days. Data from day one and the mean of all days (MOAD) were examined. P50 and N100 amplitudes and gating measures were correlated with PANSS and Wisconsin Card Sorting Test data. Utilizing day one data, no amplitude or gating measures were significantly different between the groups. Utilizing MOAD data, both P50 and N100 gating were significantly decreased in schizophrenia patients. The N100 gating deficit correlated with the negative-symptoms cluster and measures of frontal lobe dysfunction. The data suggest a correlation between N100 gating deficit and the negative-cognitive deficits dimensions of schizophrenia. Data also suggest that improving the signal to noise ratio (MOAD data) increases the sensitivity for detecting gating abnormalities and assessing their clinical correlates.}
}

